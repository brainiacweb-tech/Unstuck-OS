{
  "name": "unstuck-os",
  "version": "1.0.0",
  "private": true,
  "description": "Your PC. Uncomplicated.",
  "author": "Francis Kusi",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && esbuild src/main/main.ts --bundle --platform=node --external:electron --outfile=dist/main/main.cjs && esbuild src/preload/preload.ts --bundle --platform=node --external:electron --outfile=dist/main/preload.cjs && node scripts/copy-runtime-icon.cjs",
    "test": "vitest run",
    "lint": "eslint src tests vite.config.ts && tsc --noEmit",
    "package": "npm run build && electron-builder --win portable --x64",
    "msix": "npm run package && node scripts/package-msix.cjs",
    "test:e2e": "node scripts/smoke.cjs",
    "installer": "npm run build && electron-builder --win nsis --x64",
    "brand:assets": "powershell.exe -NoProfile -File scripts/assets.ps1",
    "test:help": "node scripts/help-smoke.cjs",
    "test:repairs": "node scripts/repair-smoke.cjs"
  },
  "build": {
    "appId": "org.unstuck.os",
    "productName": "Unstuck OS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "executableName": "Unstuck OS",
      "icon": "store-assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "extraResources": [
      {
        "from": "store-assets/licenses",
        "to": "licenses",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "fuse.js": "7.5.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.72.1",
    "vite": "8.3.6",
    "vitest": "^4.0.0"
  },
  "type": "module",
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
